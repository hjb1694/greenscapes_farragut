{% extends './partials/page.base.twig' %}
{% block head %}
    {% from './partials/head.macro.twig' import head_macro %}
    {{ head_macro('GreenScapes Outdoor Living - Landscaping and More in Tellico Village, Tennessee', '') }}
{% endblock head %}
{% block body %}
<section class="hero">
    <div class="slideshow uk-position-relative uk-visible-toggle uk-light" uk-slideshow="autoplay:true;animation:fade;max-height:725;ratio:16:9">
        <div class="slideshow__items uk-slideshow-items" uk-height-viewport="min:300">
            <div class="slideshow__item uk-position-cover uk-animation-kenburns uk-animation-reverse uk-transform-origin-center-left">
                <img class="slideshow-img" src="/public/img/hero/retaining_garden_bed.webp" alt="Retaining Garden Bed" uk-cover>
            </div>
            <div class="slideshow__item uk-position-cover uk-animation-kenburns uk-animation-reverse uk-transform-origin-center-left">
                <img class="slideshow-img" src="/public/img/hero/porch.webp" alt="Porch" uk-cover>
            </div>
            <div class="slideshow__item uk-position-cover uk-animation-kenburns uk-animation-reverse uk-transform-origin-center-left">
                <img class="slideshow-img" src="/public/img/hero/work.webp" alt="Construction of Porch" uk-cover>
            </div>
        </div>
        <a class="uk-position-absolute uk-position-center-left uk-position-small uk-hidden-hover" href uk-slidenav-previous uk-slideshow-item="previous"></a>
        <a class="uk-position-absolute uk-position-center-right uk-position-small uk-hidden-hover" href uk-slidenav-next uk-slideshow-item="next"></a>
    </div>
</section>
<section class="our-services">
    <h2 class="our-services__heading-text">Our Services</h2>
    <div class="container">
        <div class="our-services__service-tiles">
            <div class="service-tile">
                <img class="service-tile__img" src="/public/img/service_tiles/retaining_wall.webp" alt="retaining wall"/>
                <div class="service-tile__text">Retaining Walls</div>
            </div>
            <div class="service-tile">
                <img class="service-tile__img" src="/public/img/service_tiles/step_paths.webp" alt="steps and paths"/>
                <div class="service-tile__text">Steps + Walkways</div>
            </div>
            <div class="service-tile">
                <img class="service-tile__img" src="public/img/service_tiles/firepit.webp" alt="firepit"/>
                <div class="service-tile__text">Firepits + Ponds</div>
            </div>
            <div class="service-tile">
                <img class="service-tile__img" src="public/img/service_tiles/lighting.webp" alt="outdoor lighting"/>
                <div class="service-tile__text">Outdoor Lighting</div>
            </div>
            <div class="service-tile">
                <img class="service-tile__img" src="/public/img/service_tiles/garden_features.webp" alt="garden features"/>
                <div class="service-tile__text">Garden Features</div>
            </div>
            <div class="service-tile">
                <img class="service-tile__img" src="/public/img/service_tiles/porch.webp" alt="porches and patios"/>
                <div class="service-tile__text">Patios + Porches</div>
            </div>
        </div>
    </div>
</section>
{% endblock body %}
{% block scripts %}
<script src="/public/js/uikit.min.js"></script>
{% endblock scripts %}